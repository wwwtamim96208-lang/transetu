# PostgreSQL. For Neon: DATABASE_URL = pooled URL, DIRECT_URL = direct URL.
# For a local Postgres, set both to the same value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transetu"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/transetu"

# Long random strings (generate with: openssl rand -hex 32). Never commit real values.
# Changing NID_HASH_SECRET breaks duplicate detection for existing records.
# Changing CARD_TOKEN_SECRET invalidates every printed token card.
NID_HASH_SECRET="change-me-to-a-long-random-string"
CARD_TOKEN_SECRET="change-me-to-another-long-random-string"

# Optional: password for seeded demo accounts (default Demo@1234)
SEED_PASSWORD="Demo@1234"
